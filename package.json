{
  "name": "mcp-flutterwave",
  "type": "module",
  "bin": {
    "mcp-flutterwave": "build/index.js"
  },
  "version": "1.4.1",
  "mcpName": "io.github.bajoski34/mcp-flutterwave",
  "repository": {
    "type": "git",
    "url": "https://github.com/bajoski34/mcp-flutterwave.git"
  },
  "description": "MCP Server to interact with Flutterwave APIs.",
  "main": "build/index.js",
  "scripts": {
    "build": "npm run build:types && npm run generate:v4 && tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "build:app": "tsc -p app/tsconfig.json && cp -r app/public build/app/public",
    "build:all": "npm run build && npm run build:app",
    "clean": "rm -rf build",
    "build:types": "sh ./bin/generate-openapi-typescript",
    "generate:v4": "orval --config orval.config.ts",
    "start:app": "node build/app/index.js",
    "dev:app": "npm run build:all && npm run start:app",
    "test": "vitest run"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "flutterwave",
    "payment",
    "fintech",
    "ai"
  ],
  "author": "Abraham Olaobaju <olaobajua@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@mcp-ui/server": "^5.16.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openapi-fetch": "^0.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "express": "^5.3.0",
    "openapi-typescript": "^7.6.1",
    "orval": "^8.36.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": ">=7.29.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "body-parser": "^2.3.1",
    "hono": "^4.13.11"
  }
}
