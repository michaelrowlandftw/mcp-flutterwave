{
  "name": "mcp-flutterwave",
  "type": "module",
  "bin": {
    "mcp-flutterwave": "build/index.js"
  },
  "version": "2.0.0",
  "mcpName": "io.github.bajoski34/mcp-flutterwave",
  "repository": {
    "type": "git",
    "url": "https://github.com/bajoski34/mcp-flutterwave.git"
  },
  "description": "MCP Server to interact with Flutterwave APIs.",
  "main": "build/index.js",
  "scripts": {
    "build": "npm run build:types && npm run generate:v4 && tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "clean": "rm -rf build",
    "build:types": "sh ./bin/generate-openapi-typescript",
    "generate:v4": "orval --config orval.config.ts",
    "test": "vitest run",
    "test:contract": "vitest run src/__tests__/contract"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "flutterwave",
    "payment",
    "fintech",
    "ai"
  ],
  "author": "Abraham Olaobaju <olaobajua@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@mcp-ui/server": "^5.16.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openapi-fetch": "^0.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "openapi-typescript": "^7.6.1",
    "orval": "^8.36.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9",
    "zod-to-json-schema": "^3.24.6"
  },
  "overrides": {
    "undici": ">=7.29.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "body-parser": "^2.3.1",
    "hono": "^4.13.11"
  }
}
