# Copy this file (for example to flutterwave.env) and point FLW_ENV_FILE at it.
# Never commit .env — it's already gitignored.

# Test keys only: live keys are refused until Security approves live mode.
# FLW_ENV_FILE must point at this file; a .env in the working folder is not read.
# With FLW_KEY_SOURCE=keychain (set in the real environment, not here) the keys
# below come from the OS keychain instead: see docs/security.md, "Key storage".

# ── v3 (FLW_API_VERSION=v3) ──────────────────────────────────────────────
# Dashboard → Settings → API Keys. No encryption key is needed: no tool takes card data.
FLW_SECRET_KEY=

# Optional, rarely needed: overrides the v3 API path segment appended to
# https://api.flutterwave.com/. Defaults to "v3". Leave unset unless you
# know you need something else — unrelated to the v3/v4 split below.
FLW_VERSION=v3

# ── v4 (default) ─────────────────────────────────────────────────────────
# Names are listed in V4_ACCEPTED_TOOLS in src/config/acceptedTools.ts.
# v4 uses the OAuth pair below; FLW_SECRET_KEY can stay empty.
# FLW_API_VERSION=v4

# Dashboard → Settings → API Keys → v4 keys (sandbox or live).
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=

# Which v4 environment to hit. Defaults to "sandbox". "production" is refused
# while live mode is disabled.
#   sandbox    → https://developersandbox-api.flutterwave.com
#   production → https://f4bexperience.flutterwave.com
FLW_ENVIRONMENT=sandbox
